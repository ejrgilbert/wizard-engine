// Parses and runs binary .wasm files.
def main(args: Array<string>) -> int {
	// BUG:: When the below line is uncommented, the bug is triggered!
	var bug = ImportTracer.new(BasicTracing.moduleFilter).wrap;
	// If any of the monitors is a Whamm module, an outline may be needed for reflection.

	var module_imports: Vector<Decl> = Vector.new();
	var imp = FuncDecl.new(0);
	imp.imp = ImportInfo.new("wasi_snapshot_preview1", "fd_write", 0);
	module_imports.put(imp);

	var imp1 = FuncDecl.new(1);
	imp1.imp = ImportInfo.new("wasi_snapshot_preview1", "poll_oneoff", 1);
	module_imports.put(imp1);

	var processor = ModuleRegistry.get("wasi_snapshot_preview1");
	if (HostModule.?(processor)) HostModule.!(processor).init(); // XXX: abstraction break

	var imports = Array<Exportable>.new(module_imports.length);
	processor.preprocess(module_imports, imports);
	return 0;
}

// Wraps imported functions with tracing. Can apply a filter to be selective on which imports to trace.
class ImportTracer(var filter: DeclFilter) {
	def wrap(decl: Decl, ex: Exportable) -> Exportable {
		var func = Function.!(ex);
		return HostFunction.new("name", func.sig, traceCall(decl.imp, func, _));
	}
	def traceCall(imp: ImportInfo, f: Function, args: Range<Value>) -> HostResult {
		match (f) {
			wf: WasmFunction => {
				var result = Execute.call(wf, args);
				return HostResult.Throw(null);
			}
			_ => return HostResult.Throw(null); // TODO: should not happen
		}
	}
}
